# Copy this file to .env and fill in your values
# TeleGallery Environment Configuration

# Backend server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database (auto-created on first run)
DATABASE_URL=sqlite+aiosqlite:///./data/telegallery.db

# Logging
LOG_LEVEL=INFO

# Telegram API credentials (get from https://my.telegram.org)
# These are per-account and managed via the GUI
# TELEGRAM_API_ID=your_api_id_here
# TELEGRAM_API_HASH=your_api_hash_here

# Optional: encrypt Telegram session strings in SQLite (Fernet).
# TELEGALLERY_SECRET_KEY=your-long-random-secret
